<?xml version="1.0" encoding="utf-8"?>
<!-- API keys are encrypted with a device-bound Keystore key: never back them up or transfer them. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="secrets.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="secrets.xml" />
    </device-transfer>
</data-extraction-rules>
